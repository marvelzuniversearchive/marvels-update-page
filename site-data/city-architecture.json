{
  "version": "3.0",
  "artDirection": "A premium New York metropolitan skyline rendered as mature cinematic 2.5D animation: contemporary glass towers, Art Deco crowns, prewar masonry, loft buildings, residential balconies and industrial rooftops. Strong architectural variety, believable proportions, atmospheric perspective and restrained Spider-Verse-inspired ink and color treatment. Never childish, toy-like, or made from repeated blocks.",
  "motion": {
    "backgroundDrift": 0.8,
    "scrollParallax": 1.55,
    "layerSpeed": [
      0.65,
      1.05,
      1.5,
      2
    ],
    "pointerParallax": 0.8,
    "reflectionSweep": "slow diagonal sunlight reflections travel across glass facades",
    "cloudMotion": "slow layered atmospheric drift",
    "note": "Preserve independent depth layers and existing scroll response. Buildings remain anchored as a coherent city; only camera drift, parallax, cloud movement and reflected light animate."
  },
  "rendering": {
    "style": "cinematic hand-painted urban environment with subtle graphic-novel edge treatment",
    "outline": "fine variable architectural edges; no thick cartoon outlines",
    "facadeDepth": "recessed glazing, real floor plates, deep window reveals, side planes, overhang shadows and varied roof silhouettes",
    "materials": [
      "blue-grey curtain glass",
      "limestone",
      "warm concrete",
      "weathered steel",
      "red-brown brick",
      "pale stone",
      "dark reflective glass"
    ],
    "avoid": [
      "toy-like rectangular blocks",
      "oversized cartoon bevels",
      "uniform square window grids",
      "floating bridge pieces",
      "random neon outlines",
      "checkerboard lights",
      "thick black outlines",
      "excessive halftone",
      "repeating identical towers"
    ]
  },
